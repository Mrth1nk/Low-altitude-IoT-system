[Unit]
Description=Low-altitude infrared tracking and precision landing
After=dev-ttyS9.device low-altitude-aircraft.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=elf
Group=elf
SupplementaryGroups=dialout video
WorkingDirectory=/opt/low-altitude-iot/current
EnvironmentFile=/etc/low-altitude-iot/aircraft.env
Environment=AIRCRAFT_RUNTIME_DIR=/run/low-altitude-iot
Environment=PLND_FINAL_DESCENT_ALT_M=0.25
ExecStartPre=/usr/local/lib/low-altitude-iot/check_serial_roles.sh vision
ExecStart=/usr/bin/python3 -m vision.runtime
Restart=on-failure
RestartSec=2
RuntimeDirectory=low-altitude-iot
RuntimeDirectoryPreserve=yes
UMask=0077
DevicePolicy=closed
DeviceAllow=/dev/ttyS9 rw
DeviceAllow=char-video4linux rw
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
