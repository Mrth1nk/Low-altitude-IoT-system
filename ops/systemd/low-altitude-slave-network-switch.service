[Unit]
Description=Switch aircraft-2 RDK to maintenance hotspot
After=NetworkManager.service
Requires=NetworkManager.service

[Service]
Type=oneshot
User=root
Environment="PHONE_WIFI_PROFILE=Mr.think的Mate 70 Pro+"
Environment="SLAVE_NETWORK_REQUEST_PATH=/run/low-altitude-slave/network-mode"
ExecStartPre=/bin/sleep 2
ExecStart=/usr/local/lib/low-altitude-iot/switch_slave_network.sh
