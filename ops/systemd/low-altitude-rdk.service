[Unit]
Description=Low-altitude IoT Rover and Tuya agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sunrise
WorkingDirectory=/opt/low-altitude-iot/current/rdk_agent
ExecStart=/opt/low-altitude-iot/current/rdk_agent/start_rover_stack.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
