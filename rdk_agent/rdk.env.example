# Copy to /etc/low-altitude-iot/rdk.env and set mode 0600.
# Use a unique random value of at least 16 bytes. Do not commit the real value.
AIRCRAFT_LINK_PSK=REPLACE_WITH_UNTRACKED_RANDOM_VALUE

# Disabled preserves the stable single-aircraft runtime byte-for-byte.
SLAVE_NODE_ENABLED=0
SLAVE_LOCAL_HOST=0.0.0.0
SLAVE_LOCAL_PORT=14610
SLAVE_PEER_HOST=192.168.4.3
SLAVE_PEER_PORT=14620
SLAVE_STATUS_TIMEOUT_SEC=3.0
SLAVE_RETRY_INTERVAL_SEC=0.5
SLAVE_MAX_ATTEMPTS=6
